{
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[vue]": {
        "editor.defaultFormatter": "Vue.volar"
    },
    "chat.agent.maxRequests": 25000,
    "chat.mcp.gallery.enabled": true,
    "chat.tools.global.autoApprove": true,
    "chat.useAgentSkills": true,
    "chat.viewSessions.enabled": false,
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.renderSideBySide": false,
    "editor.aiStats.enabled": false,
    "editor.copyWithSyntaxHighlighting": false,
    "editor.cursorBlinking": "smooth",
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.defaultFormatter": null,
    "editor.detectIndentation": false,
    "editor.emptySelectionClipboard": false,
    "editor.fontFamily": "'JetBrainsMono Nerd Font', monospace",
    "editor.fontLigatures": true,
    "editor.fontSize": 15,
    "editor.formatOnSave": true,
    "editor.gotoLocation.multipleDeclarations": "goto",
    "editor.gotoLocation.multipleDefinitions": "goto",
    "editor.gotoLocation.multipleImplementations": "goto",
    "editor.gotoLocation.multipleReferences": "goto",
    "editor.gotoLocation.multipleTypeDefinitions": "goto",
    "editor.hideCursorInOverviewRuler": true,
    "editor.hover.enabled": "off",
    "editor.lightbulb.enabled": "off",
    "editor.lineNumbers": "off",
    "editor.minimap.enabled": false,
    "editor.multiCursorModifier": "ctrlCmd",
    "editor.occurrencesHighlight": "singleFile",
    "editor.overviewRulerBorder": false,
    "editor.renderControlCharacters": false,
    "editor.renderLineHighlight": "none",
    "editor.rulers": [
        80,
        120
    ],
    "editor.selectionHighlight": false,
    "editor.smoothScrolling": true,
    "editor.suggestFontSize": 15,
    "editor.suggestLineHeight": 28,
    "editor.unicodeHighlight.ambiguousCharacters": false,
    "editor.unicodeHighlight.invisibleCharacters": false,
    "editor.unicodeHighlight.nonBasicASCII": false,
    "editor.wordSeparators": "`~!@#%^&*()=+[{]}\\|;:'\",.<>/?-$",
    "explorer.compactFolders": false,
    "explorer.confirmDragAndDrop": false,
    "explorer.confirmPasteNative": false,
    "explorer.fileNesting.enabled": true,
    "explorer.fileNesting.patterns": {
        "*.db": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.s3db": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.sqlite": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.ts": "${capture}.js",
        "*.tsx": "${capture}.ts",
        ".env": ".env.*,.git*,*.ini, *.sample,.htaccess,.editorconfig,env-example",
        ".env.local": ".env*",
        ".gitignore": ".env.*,.git*,*.ini, *.sample,.htaccess,.editorconfig,env-example",
        "README.md": "*.md, COPYING.txt, LICENSE*",
        "compose.yml": "compose*.yml, docker-compose*.yml",
        "composer.json": "composer.*,auth.json*,.php-cs*,captainhook.*",
        "docker-compose.yml": "compose*.yml, docker-compose*.yml",
        "env-example": ".env.*,.git*,*.ini, *.sample,.htaccess,.editorconfig",
        "index.php": "*.php",
        "package.json": "package*.json, Gruntfile.js*, .eslint*, prettier*, tsconfig*, vite*, pnpm-lock*, bun.lockb, nest*",
        "phpcs.*": "phpcs.*,phpunit.*,phpstan.*",
        "style.css": "*.css",
        "tailwind.config.js": "tailwind.config*, postcss.config*",
        "tsconfig.json": "tsconfig.*.json"
    },
    "files.associations": {
        ".dev.vars": "dotenv",
        ".env.*": "dotenv",
        ".prettierrc": "json",
        "*.css": "css"
    },
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,
    "git.confirmSync": false,
    "git.decorations.enabled": false,
    "github.copilot.chat.commitMessageGeneration.instructions": [],
    "github.copilot.enable": {
        "markdown": true,
        "plaintext": true
    },
    "github.copilot.nextEditSuggestions.enabled": false,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "php.suggest.basic": false,
    "problems.decorations.enabled": false,
    "scm.diffDecorations": "none",
    "search.exclude": {
        ".phpunit.result.cache": true,
        "**/_ide_helper.php": true,
        "**/composer.lock": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/package-lock.json": true,
        "**/public/{[^i],?[^n]}*": true,
        "**/vendor/{[^l],?[^ai]}*": true,
        "storage": true
    },
    "search.useIgnoreFiles": false,
    "symbols.files.associations": {
        ".env.development.local": "gear",
        ".env.example": "gear",
        ".env.local": "gear",
        ".env.test.local": "gear",
        "*.e2e-spec.ts": "ts-test",
        "*.guard.ts": "typescript",
        "*.mock.ts": "ts-test",
        "*.module.ts": "nest",
        "*.spec.ts": "ts-test",
        "vitest.config.e2e.ts": "vite"
    },
    "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.gpuAcceleration": "on",
    "terminal.integrated.smoothScrolling": true,
    "typescript.updateImportsOnFileMove.enabled": "always",
    "window.autoDetectColorScheme": false,
    "window.commandCenter": false,
    "window.menuBarVisibility": "compact",
    "window.nativeFullScreen": false,
    "window.newWindowDimensions": "inherit",
    "window.titleBarStyle": "custom",
    "workbench.agentsWindowButton.enabled": false,
    "workbench.colorTheme": "Monokai",
    "workbench.editor.editorActionsLocation": "hidden",
    "workbench.editor.empty.hint": "hidden",
    "workbench.editor.enablePreview": false,
    "workbench.editor.enablePreviewFromQuickOpen": false,
    "workbench.iconTheme": "material-icon-theme",
    "workbench.layoutControl.enabled": false,
    "workbench.list.smoothScrolling": true,
    "workbench.navigationControl.enabled": false,
    "workbench.sideBar.location": "right",
    "workbench.startupEditor": "none",
    "workbench.tips.enabled": false,
    "workbench.tree.indent": 25,
    "workbench.tree.renderIndentGuides": "always"
}
