[user]
    name = Marcos "Marcão" Aurelio
    email = macosaures+noreply@gmail.com

[core]
    editor = nano
    autocrlf = input
    safecrlf = warn
    excludesfile = ~/.gitignore_global

[init]
    defaultBranch = main

[alias]
    co = checkout
    ci = commit
    st = status
    br = branch
    hist = log --pretty=format:\"%h %ad | %s%d [%an]\" --graph --date=short
    type = cat-file -t
    dump = cat-file -p

[diff]
    tool = vimdiff

[merge]
    tool = vimdiff

[pull]
    rebase = true

[push]
    default = simple

[color]
    ui = auto
    branch = auto
    diff = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = yellow
    changed = green
    untracked = cyan